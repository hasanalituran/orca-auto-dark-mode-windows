{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "toggle-light-dark-theme",
  "name": "Toggle Light/Dark Theme",
  "version": "0.1.7",
  "execution": "trusted-worker",
  "pluginApi": 1,
  "description": "Toggle Orca between light and dark themes from the status bar. Pick any installed theme for each mode in the Theme Picker panel; the status bar button switches instantly. Defaults to Orca's neutral palette when no theme is configured.",
  "license": "MIT",
  "author": { "name": "hasanalituran" },
  "repository": "https://github.com/hasanalituran/orca-auto-dark-mode-windows",
  "engines": {
    "orca": ">=1.4.251"
  },
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "theme-picker",
        "title": "Theme Picker",
        "icon": "lightbulb",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      {
        "id": "toggle",
        "title": "Toggle Light/Dark Theme"
      },
      {
        "id": "list-themes",
        "title": "List Installed Themes"
      }
    ],
    "statusBarItems": [
      {
        "id": "toggle",
        "text": "☀",
        "tooltip": "Toggle between light and dark themes",
        "command": "toggle"
      }
    ]
  },
  "capabilities": [
    { "kind": "storage:own" },
    { "kind": "appearance:write" }
  ]
}