{
  "manifestVersion": 2,
  "id": "toggle-light-dark-theme",
  "name": "Toggle Light/Dark Theme",
  "version": "0.1.2",
  "execution": "trusted-worker",
  "pluginApi": 1,
  "description": "Status bar button to toggle Orca between light and dark themes.",
  "license": "MIT",
  "repository": "https://github.com/hasanturan/orca-toggle-theme",
  "engines": {
    "orca": ">=1.4.251"
  },
  "main": "src/worker.ts",
  "contributes": {
    "commands": [
      {
        "id": "toggle",
        "title": "Toggle Light/Dark Theme"
      },
      {
        "id": "list-themes",
        "title": "List Installed Themes"
      }
    ],
    "statusBarItems": [
      {
        "id": "toggle",
        "text": "Theme",
        "icon": "lightbulb",
        "tooltip": "Toggle between light and dark themes",
        "command": "toggle"
      }
    ],
    "settings": [
      {
        "key": "lightTheme",
        "title": "Light theme",
        "description": "Content id of the theme to apply in light mode, e.g. plugin:stablyai.orca-ayu-theme/ayu-light",
        "type": "string",
        "default": "plugin:stablyai.orca-ayu-theme/ayu-light"
      },
      {
        "key": "darkTheme",
        "title": "Dark theme",
        "description": "Content id of the theme to apply in dark mode, e.g. plugin:stablyai.orca-ayu-theme/ayu-dark",
        "type": "string",
        "default": "plugin:stablyai.orca-ayu-theme/ayu-dark"
      }
    ]
  },
  "capabilities": [
    { "kind": "storage:own" },
    { "kind": "settings:own" },
    { "kind": "appearance:write" }
  ]
}